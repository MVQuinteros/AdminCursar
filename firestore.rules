rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function esDuenio(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // --- Contenido público + semilla (el seed corre ANTES del login) ---
    //
    // Siguen abiertos a escritura porque la semilla de la app escribe acá al
    // arrancar, antes de que exista sesión. Endurecerlos (write: isAdmin())
    // implica sacar la semilla de la app; queda pendiente.
    match /instituciones/{id} {
      allow read, write: if true;
    }
    match /ofertas/{id} {
      allow read, write: if true;
    }
    match /avisos/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if true;
    }

    // Los tags NO los escribe la app (solo el panel); sí los lee sin sesión.
    match /tags/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // El test vocacional se alcanza solo con sesión (desde Perfil), así que
    // escribir exige estar logueado; leer es público para la pantalla de inicio.
    match /testVocacional/{docId=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- Datos personales: el dueño (+ admin web) ---
    //
    // El dueño ya no puede escribir cualquier campo de su documento: `rol` y
    // `uid` quedan fuera de las listas, si no cualquiera se promovía a admin
    // con un update sobre su propio `usuarios/{uid}`.
    match /usuarios/{uid} {
      allow read: if isAdmin() || esDuenio(uid);

      // Alta desde la app (email/contraseña o Google) o desde el panel.
      allow create: if isAdmin() || (esDuenio(uid)
        && request.resource.data.uid == uid
        && request.resource.data.rol == 'usuario'
        && request.resource.data.keys().hasOnly([
          'uid', 'nombre', 'apellido', 'nombreCompleto', 'email', 'rol',
          'contrasenaHash', 'ultimoLogin', 'fechaNacimiento', 'localidad',
          'fotoURL', 'createdAt', 'updatedAt'
        ]));

      // Edición del perfil y de las preferencias. La lista es lo que la app
      // realmente escribe (perfil, config, favoritos, modo oscuro, preferencias
      // de búsqueda); cualquier campo nuevo hay que agregarlo acá.
      allow update: if isAdmin() || (esDuenio(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'apellido', 'nombreCompleto', 'localidad',
          'radioBusqueda', 'modalidad', 'tipoInstitucion', 'fotoURL',
          'modoOscuro', 'notificaciones', 'ubicacionAutomatica',
          'avisosLeidos', 'ultimoLogin', 'fechaNacimiento'
        ]));

      allow delete: if isAdmin();
    }
    match /usuarios/{uid}/favoritos/{id} {
      allow read, write: if esDuenio(uid);
    }
    match /usuarios/{uid}/historial/{id} {
      allow read, write: if esDuenio(uid);
    }
    match /notificaciones/{id} {
      // El admin crea avisos para otros usuarios (ej. la respuesta a un
      // reporte de soporte); cada usuario crea los suyos.
      allow create: if isAdmin() || (request.auth != null
        && request.resource.data.userUid == request.auth.uid);
      allow read, update, delete: if isAdmin() || (request.auth != null
        && resource.data.userUid == request.auth.uid);
    }
    match /soporte/{id} {
      // La app escribe el uid del que pregunta. Si todavía no lo manda (versión
      // vieja de la app) se acepta igual, para no cortar el alta de tickets.
      allow create: if request.auth != null
        && (!('userUid' in request.resource.data)
          || request.resource.data.userUid == request.auth.uid);
      // El dueño lee su propio reporte (para ver la respuesta del admin);
      // el admin lee, actualiza y borra todo.
      //
      // El uid del autor viene en `userUid` en los tickets cargados desde el
      // panel, pero la app móvil lo escribe en `uid`; se aceptan los dos, si no
      // el autor no puede leer su propio reporte ni la respuesta.
      allow read: if isAdmin() || (request.auth != null
        && (('userUid' in resource.data
              && resource.data.userUid == request.auth.uid)
            || ('uid' in resource.data
              && resource.data.uid == request.auth.uid)));
      allow update, delete: if isAdmin();
    }
    match /mensajes/{id} {
      // Colección sin pantallas que la usen (la app solo la lee filtrando por
      // `userUid`): cada uno lee los suyos y solo el panel escribe. Antes
      // cualquier usuario logueado podía leer los mensajes de todos.
      allow read: if isAdmin() || (request.auth != null
        && resource.data.userUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
  }
}
